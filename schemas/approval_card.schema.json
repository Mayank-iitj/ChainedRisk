{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovalCard",
  "type": "object",
  "required": ["id", "step_id", "status", "command", "command_hash", "target", "risk_level", "blast_radius", "reason", "expires_at"],
  "properties": {
    "id": {"type": "string"},
    "step_id": {"type": "string"},
    "status": {"enum": ["pending", "approved", "denied", "expired", "cancelled", "consumed"]},
    "title": {"type": "string"},
    "command": {"type": "string"},
    "command_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{8,64}$"},
    "target": {"type": "object", "required": ["asset_id", "container", "ip"], "properties": {"asset_id": {"type": "string"}, "container": {"type": "string"}, "ip": {"type": "string"}}},
    "risk_level": {"enum": ["L0", "L1", "L2", "L3"]},
    "blast_radius": {
      "type": "object",
      "required": ["score", "reachable_assets", "state_change", "network_scope"],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "reachable_assets": {"type": "array", "items": {"type": "string"}},
        "datastores": {"type": "array", "items": {"type": "object"}},
        "credentials_in_scope": {"type": "integer"},
        "state_change": {"enum": ["none", "reversible", "irreversible"]},
        "network_scope": {"enum": ["lab-only"]}
      }
    },
    "reason": {"type": "string"},
    "rollback": {"type": "string"},
    "timeout_s": {"type": "integer", "maximum": 60},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
