{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finding",
  "type": "object",
  "required": ["id", "title", "stage", "severity", "asset_id", "source_tool", "rule_id"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "stage": {"enum": ["recon", "config", "vuln"]},
    "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
    "cvss": {"type": "number", "minimum": 0, "maximum": 10},
    "asset_id": {"type": "string"},
    "source_tool": {"type": "string"},
    "rule_id": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "object", "properties": {"request": {"type": "string"}, "response_snippet": {"type": "string", "maxLength": 2000}, "digest": {"type": "string"}}},
    "provides": {"type": "array", "items": {"type": "string"}},
    "requires": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "cwe": {"type": "array", "items": {"type": "string"}},
    "attack": {"type": "array", "items": {"type": "string"}}
  }
}
