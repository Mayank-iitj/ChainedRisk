{
  "project": {
    "name": "Demo: SpiceHub lab",
    "scope": {
      "cidrs": [
        "10.77.0.0/24"
      ],
      "lab_only": true
    }
  },
  "assets": [
    {
      "id": "ast_app",
      "type": "Host",
      "name": "app.lab",
      "ip": "10.77.0.10",
      "zone": "dmz",
      "services": [
        {
          "port": 8080,
          "proto": "tcp",
          "product": "flask"
        }
      ]
    },
    {
      "id": "ast_git",
      "type": "Host",
      "name": "git.lab",
      "ip": "10.77.0.11",
      "zone": "internal",
      "services": [
        {
          "port": 80,
          "proto": "tcp",
          "product": "nginx"
        }
      ]
    },
    {
      "id": "ast_redis",
      "type": "Host",
      "name": "redis.lab",
      "ip": "10.77.0.12",
      "zone": "internal",
      "services": [
        {
          "port": 6379,
          "proto": "tcp",
          "product": "redis",
          "auth": "none"
        }
      ],
      "datastores": [
        {
          "id": "ds_cache",
          "kind": "cache",
          "sensitivity": "synthetic"
        }
      ]
    }
  ],
  "findings": [
    {
      "id": "fnd_git",
      "title": "Exposed .git/config",
      "stage": "config",
      "severity": "low",
      "asset_id": "ast_app",
      "source_tool": "nuclei",
      "rule_id": "git-config-exposure",
      "confidence": 0.9,
      "evidence": {
        "response_snippet": "[remote origin] url = http://git.lab:80/app.git ; redis.lab:6379"
      },
      "provides": [
        "internal_url_disclosure",
        "source_repo_access"
      ],
      "requires": [],
      "tags": [
        "info_disclosure"
      ]
    },
    {
      "id": "fnd_ssrf",
      "title": "Server-side request forgery in /fetch?u=",
      "stage": "vuln",
      "severity": "medium",
      "asset_id": "ast_app",
      "source_tool": "nuclei",
      "rule_id": "ssrf-fetch",
      "confidence": 0.9,
      "evidence": {
        "response_snippet": "GET /fetch?u=http://git.lab/ -> 200"
      },
      "provides": [
        "net_pivot_internal"
      ],
      "requires": [
        "internal_url_disclosure"
      ],
      "tags": [
        "ssrf"
      ]
    },
    {
      "id": "fnd_redis",
      "title": "Redis without authentication",
      "stage": "config",
      "severity": "medium",
      "asset_id": "ast_redis",
      "source_tool": "nmap",
      "rule_id": "redis-unauth",
      "confidence": 0.9,
      "evidence": {
        "response_snippet": "6379/tcp open redis; no AUTH required"
      },
      "provides": [
        "data_exfil",
        "code_exec_possible"
      ],
      "requires": [
        "net_pivot_internal"
      ],
      "tags": [
        "unauth"
      ]
    },
