{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chain",
  "type": "object",
  "required": ["id", "title", "score", "severity", "steps", "status"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "score": {"type": "integer", "minimum": 0, "maximum": 100},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "chain_gain": {"type": "integer"},
    "origin": {"enum": ["rule", "llm", "rule+llm"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["hypothesis", "planned", "verifying", "confirmed", "not_reproduced", "blocked", "dismissed"]},
    "steps": {
      "type": "array", "minItems": 2, "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["order", "finding_ids", "requires", "provides"],
        "properties": {
          "order": {"type": "integer"},
          "finding_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "requires": {"type": "array", "items": {"type": "string"}},
          "provides": {"type": "array", "items": {"type": "string"}},
          "narrative": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
